{% extends 'base.html.twig' %}

{% block title %}Accueil | SF6 - Eshop
{% endblock %}

{% block body %}
	<h1>Nos produits phares</h1>
	{# Cartes Produits #}
	<div class="row">
		{% for i in 1..3 %}
			<div class="col">
				<div class="card">
					<img src="https://picsum.photos/200/200" class="img-fluid" alt="Image du produit">
					<div class="card-body">
						<h4 class="card-title">Superbe chaise en bois</h4>
						<p class="card-text">Lorem ipsum dolor sit, amet consectetur adipisicing elit. Cupiditate, temporibus.</p>
						<a href="#" class="btn btn-primary btn-sm">Détails</a>
						<a href="#" class="btn btn-success btn-sm">Ajouter</a>
					</div>
				</div>
			</div>
		{% endfor %}
	</div>

	<hr>

	{# Zone d'incitation à l'achat #}
	<h2>Un service irréprochable</h2>
	<p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Rem rerum eligendi ipsam quo quisquam ad!</p>

	<div class="row">
		{% include "shared/_purchase-incentive.html.twig" with {
            'color': 'primary',
            'icone': 'fas fa-truck',
            'text': "Lorem ipsum dolor sit amet consectetur, adipisicing elit. Atque repudiandae, optio nisi magnam qui reprehenderit?"
        } %}
		{% include "shared/_purchase-incentive.html.twig" with {
            'color': 'success',
            'icone': 'fas fa-check',
            'text': "Lorem ipsum dolor sit amet consectetur, adipisicing elit. Atque repudiandae, optio nisi magnam qui reprehenderit?"
        } %}
		{% include "shared/_purchase-incentive.html.twig" with {
            'color': 'warning',
            'icone': 'fas fa-lock',
            'text': "Lorem ipsum dolor sit amet consectetur, adipisicing elit. Atque repudiandae, optio nisi magnam qui reprehenderit?"
        } %}
	</div>

{% endblock %}
