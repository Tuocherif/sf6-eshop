{% extends "base.html.twig" %}

{% block title %}
	Catégorie :
	{{category.name}}
{% endblock %}

{% block body %}
	<h1>Catégorie :
		{{category.name}}</h1>

	<div
		class="row">
		{# Pour chaque produit parmi les produits de la catégorie en cours de traitement #}
		{% for p in category.products %}
			{# On affiche le produit #}
			<div
				{# L'affichage se fait sur 4 colonnes #}
				class="col-3">
				<div class="card">
					<img src="{{ p.picture }}" class="img-fluid" alt="Image du produit">

					<div class="card-body">
						<h4 class="card-title">{{ p.name }}
							({{ (p.price)/100 }}
							&euro;)</h4>

						<span class="badge bg-info">
							{{ p.category.name }}
						</span>

						<p class="card-text">{{ p.description }}</p>

						<a href="#" class="btn btn-primary btn-sm">Détails</a>

						<a href="#" class="btn btn-success btn-sm">Ajouter</a>
					</div>
				</div>
			</div>
		{% endfor %}
	</div>

{% endblock %}
